.gitattributes text eol=lf
.githooks/* text eol=lf
.github/workflows/* text eol=lf
*.sh text eol=lf
winsmux-core/router/*.json text eol=lf
winsmux-core/scripts/coordinator-router.ps1 text eol=lf
winsmux-core/scripts/local-router-shadow.ps1 text eol=lf

# GitHub Languages should emphasize the primary Rust/Tauri implementation.
# PowerShell remains supported for installer, generated bundle, orchestration,
# operational script, and test-harness surfaces.
.githooks/*.ps1 linguist-detectable=false
install.ps1 linguist-detectable=false
install.ps1 text eol=lf
scripts/*.ps1 linguist-detectable=false
scripts/winsmux-core.ps1 linguist-generated=true
tasks/*.psd1 linguist-detectable=false
tests/*.ps1 linguist-detectable=false
winsmux-core/*.ps1 linguist-detectable=false
winsmux-core/scripts/*.ps1 linguist-detectable=false
core/scripts/*.ps1 linguist-detectable=false
core/tests/*.ps1 linguist-detectable=false
core/crates/winsmux-workspace/schema/request.schema.json text eol=lf
core/crates/winsmux-workspace/schema/response.schema.json text eol=lf
core/crates/winsmux-workspace/schema/snapshot.schema.json text eol=lf
winsmux-app/src/generated/workspace-contract.ts text eol=lf

# Frozen license documents, inventories and source archives bind their raw bytes.
distribution/windows-licenses/** -text

# These upstream NSIS compiler inputs are verified by their exact raw SHA-256.
winsmux-app/src-tauri/nsis/installer.nsi -text
winsmux-app/src-tauri/nsis/winsmux-utils.nsh -text
