{
  "auth": {
    "request_field": "auth.token",
    "required_for_methods": true,
    "token_env": "WINSMUX_CONTROL_PIPE_TOKEN",
    "token_file": "%LOCALAPPDATA%\\winsmux\\control-pipe\\token"
  },
  "desktop_methods": [
    "desktop.control_plane.contract",
    "desktop.summary.snapshot",
    "desktop.run.explain",
    "desktop.run.compare",
    "desktop.run.promote",
    "desktop.run.pick_winner",
    "desktop.voice.capture_status"
  ],
  "internal_desktop_methods_excluded": [
    "desktop.workers.status",
    "desktop.workers.start",
    "desktop.runtime.roles.apply",
    "desktop.dogfood.event",
    "desktop.explorer.list",
    "desktop.editor.read"
  ],
  "jsonrpc": "2.0",
  "localhost_http": false,
  "methods": [
    "desktop.control_plane.contract",
    "desktop.summary.snapshot",
    "desktop.run.explain",
    "desktop.run.compare",
    "desktop.run.promote",
    "desktop.run.pick_winner",
    "desktop.voice.capture_status",
    "pty.spawn",
    "pty.write",
    "pty.resize",
    "pty.capture",
    "pty.respawn",
    "pty.close",
    "desktop.operator.snapshot",
    "desktop.operator.submit",
    "desktop.pairing.confirm"
  ],
  "operator_methods": [
    "desktop.operator.snapshot",
    "desktop.operator.submit"
  ],
  "pairing_methods": [
    "desktop.pairing.confirm"
  ],
  "pipe": "\\\\.\\pipe\\winsmux-control",
  "pty_methods": [
    "pty.spawn",
    "pty.write",
    "pty.resize",
    "pty.capture",
    "pty.respawn",
    "pty.close"
  ],
  "scope": "external_control_pipe",
  "transport": "named_pipe_json_rpc",
  "version": 1,
  "websocket": false
}
